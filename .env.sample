# Copy this file to .env in the directory where you run lenzcontext.
# Existing environment variables take precedence over these values.
# Explicit CLI options take precedence over environment variables.

# OpenAI-compatible API base URL (use your provider's URL).
LENZCONTEXT_API_BASE=http://localhost:8000/v1

# Required: your vision-capable model identifier.
LENZCONTEXT_MODEL=your-vision-model

# Your provider's API key. Leave empty for a local server without authentication.
LENZCONTEXT_API_KEY=

# Optional defaults; paths are relative to the working directory.
# LENZCONTEXT_GEONAMES_DB=data/geonames.db
# Leave unset to search the default prompt locations automatically.
# LENZCONTEXT_PROMPT_CONFIG=config/prompts.yaml
# LENZCONTEXT_DESCRIPTION_LANGUAGE=English
# Positive timeout in seconds for each API request attempt.
# LENZCONTEXT_TIMEOUT=120
# Maximum requests per image; 0 retries indefinitely.
# LENZCONTEXT_RETRIES=5
# Maximum simultaneous LLM analyses; positive integer. 1 processes sequentially.
# LENZCONTEXT_JOBS=1
